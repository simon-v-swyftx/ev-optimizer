{
  "name": "ev-optimiser",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "triggers": {
    // One 5-min tick; all local-time gating is in code (DAY_START through
    // SOLAR_SOAK_END, plus the nightly load pull at 01:00 local), so this
    // never needs editing for your timezone.
    // Shadow mode (D1 config shadow_mode, default on) logs decisions without
    // sending car commands; set it to 'false' once you trust the log.
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ev_optimiser",
      // `wrangler d1 create ev_optimiser` prints this. CI substitutes the
      // D1_DATABASE_ID repo secret, so the placeholder can stay committed.
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  // Site facts, read by src/site.ts. All required; the Worker refuses to act
  // (and alerts) if one is missing or malformed. The values below are an
  // example install — change every one to match yours.
  "vars": {
    // IANA time zone of the site. Daylight saving is followed automatically:
    // every time below is local wall-clock time, so e.g. Australia/Sydney
    // keeps the free window at 11:00 local in both AEST and AEDT.
    "TIME_ZONE": "Australia/Brisbane",
    // Free (or cheap) grid window, local time. Start must be on :00 or :30.
    "FREE_WINDOW_START": "11:00",
    "FREE_WINDOW_END": "14:00",
    // First tick of the day: the morning plan runs here.
    "DAY_START": "05:30",
    // Afternoon solar soak hard stop — keep it before any scheduled evening
    // battery export. No fresh soak starts in its final hour.
    "SOLAR_SOAK_END": "17:30",
    // Home battery usable capacity.
    "BATTERY_KWH": 42,
    // Battery's own minimum SoC (BMS floor), %. The house reserve never sits
    // below it; assumed when the FoxESS minSocOnGrid read fails.
    "BATTERY_MIN_SOC": 10,
    // Charger: watts per amp = volts x phases (230 V three-phase = 690 W/A).
    "CHARGER_VOLTS": 230,
    "CHARGER_PHASES": 3,
    "CHARGER_MIN_AMPS": 5,
    "CHARGER_MAX_AMPS": 16,
    // Car counts as home within this radius of D1 config home_lat/home_lon.
    "HOME_RADIUS_M": 150
    // Optional: "NTFY_URL": "https://ntfy.example.org" for a self-hosted ntfy.
  }
}
